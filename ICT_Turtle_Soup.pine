//@version=5
strategy("ICT Turtle Soup - Final Combined", overlay=true, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=1)

// --- Inputs ---
swing_len = input.int(20, "Swing Length")
rr_ratio = input.float(2.0, "Take Profit (R)")
be_trigger = input.float(0.5, "Breakeven Trigger (R)")

// --- Variables to track management ---
var float entry_price = 0.0
var float stop_loss = 0.0
var bool is_be = false

// --- ICT Logic ---
swing_high = ta.highest(high[1], swing_len)
swing_low = ta.lowest(low[1], swing_len)

// Turtle Soup Reversal: Sweep and close back inside
is_sweep_low = low < swing_low and close > swing_low
is_sweep_high = high > swing_high and close < swing_high

// --- Trade Execution ---
if strategy.position_size == 0
    is_be := false
    if is_sweep_low
        entry_price := close
        stop_loss := low
        float risk = entry_price - stop_loss
        strategy.entry("Long", strategy.long)
        strategy.exit("Exit Long", "Long", stop=stop_loss, limit=entry_price + (risk * rr_ratio))
        
    if is_sweep_high
        entry_price := close
        stop_loss := high
        float risk = stop_loss - entry_price
        strategy.entry("Short", strategy.short)
        strategy.exit("Exit Short", "Short", stop=stop_loss, limit=entry_price - (risk * rr_ratio))

// --- Breakeven Management ---
if strategy.position_size != 0 and not is_be
    float risk = math.abs(entry_price - stop_loss)
    
    // Check if price moved 0.5R in our favor
    if strategy.position_size > 0 and (close - entry_price) >= (risk * be_trigger)
        strategy.exit("Exit Long", "Long", stop=entry_price)
        is_be := true
        
    if strategy.position_size < 0 and (entry_price - close) >= (risk * be_trigger)
        strategy.exit("Exit Short", "Short", stop=entry_price)
        is_be := true
